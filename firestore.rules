rules_version = '2';
// TripTracker rules. Paste into Firebase Console → Firestore → Rules → Publish.
// Only the app's (anonymous) signed-in users can read or write. Trip PINs are stored hashed.
service cloud.firestore {
  match /databases/{database}/documents {

    match /trips/{tripId} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.participants is list && request.resource.data.participants.size() > 0;

      match /expenses/{expenseId} {
        allow read, delete: if request.auth != null;
        allow create, update: if request.auth != null
          && request.resource.data.type in ['expense', 'income']
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && request.resource.data.convertedAmount is number;
      }

      // Shrunk expense photos (JPEG data URL, under ~900 KB each).
      match /photos/{photoId} {
        allow read, delete: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.expenseId is string
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000
          && request.resource.data.data.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$');
      }
    }

    match /settings/categories {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.list is list;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
